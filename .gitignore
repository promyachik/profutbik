 
# PROMYACHIK CLEAN PROJECT LOCK 
.hugo_build.lock 
public/ 
resources/_gen/ 
*.log 
__pycache__/ 
*.pyc 
*.pyo 
.DS_Store 
Thumbs.db 

# секреты и локальное — в публичный репозиторий не пускать
.env
.env.*
*.key
*.pem
config/*.env
secrets/
*.bak
*.tmp

# Рабочий каталог автопилота: снимки для отката и отчёты о прогоне.
# Раннер одноразовый, после такта они бесполезны, а коммит каждые полчаса
# раздувал бы репозиторий.
autopilot/work/

# Движок 3.4 заморожен и хранит корень ProFutbik виндовой строкой. На Linux
# это относительный путь, и рядом с движком возникает папка с буквальным
# именем "C:\Users\...". Правится не движок, а то, что она сюда не едет.
autopilot/bin/C:*
C:\Users\*
